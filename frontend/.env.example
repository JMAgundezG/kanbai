# Copy to .env.local to override. Empty means "same origin": in development the
# Vite proxy forwards /api to the backend, so nothing needs to be set.
# A production build has no proxy: point this at the API if it lives elsewhere.
VITE_API_BASE_URL=

# El proxy de desarrollo se configura al arrancar Vite, no desde este archivo:
# VITE_PROXY_TARGET=http://localhost:8000 pnpm run dev
