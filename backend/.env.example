# Copy to .env for local development. No real secrets in this file, ever.
KANBAI_ENVIRONMENT=local
KANBAI_LOG_LEVEL=INFO

# Shown here because they are part of the API contract: change either one and the
# committed openapi.json no longer matches what the server serves.
KANBAI_APP_NAME=kanbai
KANBAI_API_V1_PREFIX=/api/v1

# Matches the credentials in compose.yaml at the repository root.
KANBAI_DATABASE_URL=postgresql+psycopg://kanbai:kanbai@localhost:5432/kanbai
KANBAI_DB_ECHO=false

KANBAI_CORS_ORIGINS=["http://localhost:5173"]

# Sesión de personas: cookie httpOnly con un token opaco respaldado en la tabla
# `sessions` (el propio token nunca se guarda, solo su hash SHA-256).
KANBAI_SESSION_COOKIE_NAME=kanbai_session
KANBAI_SESSION_TTL_DAYS=14

# Solo para la suite de tests: expórtala en la shell antes de ejecutar pytest si
# necesitas aislar otra base. No la añadas al archivo .env: Settings rechaza claves
# que no pertenecen a la configuración de la aplicación.
# export KANBAI_TEST_DATABASE_URL=postgresql+psycopg://kanbai:kanbai@localhost:5432/kanbai_test
