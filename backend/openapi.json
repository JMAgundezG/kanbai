            "schema": {
              "format": "uuid",
              "title": "Board Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "column_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Column Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No eres miembro de este tablero, o la columna no existe."
          },
          "409": {
            "description": "Es la última columna del tablero."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
