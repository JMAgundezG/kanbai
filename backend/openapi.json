{
  "components": {
    "schemas": {
      "ActorRead": {
        "description": "Deliberately without `email`: an actor is identified by type and visible\nname, not by its credential. Keeps this schema agnostic of the actor's kind —\nwhen TASK-09 adds agents, the same schema serves them without changes.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "person",
              "agent"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name",
          "created_at"
        ],
        "title": "ActorRead",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "description": "Liveness: the process is up. Says nothing about its dependencies.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthRead",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ReadinessRead": {
        "description": "Readiness: the process can actually serve traffic.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessRead",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "API de tableros kanban de kanbai.",
    "title": "kanbai",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Las credenciales no son válidas."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inicia sesión con email y contraseña",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Idempotent: with no cookie, or an already-expired one, this still returns\n204 — closing a session that is not open is not an error.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Cierra la sesión actual",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No hay una sesión activa."
          }
        },
        "summary": "Actor autenticado en la sesión actual",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessRead"
                }
              }
            },
            "description": "La base de datos no está disponible."
          }
        },
        "summary": "Comprobación de disponibilidad, incluida la base de datos",
        "tags": [
          "health"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Comprobación de vida del servicio",
        "tags": [
          "health"
        ]
      }
    }
  }
}
