    "/api/v1/boards/{board_id}/columns/reorder": {
      "put": {
        "operationId": "reorder_columns_api_v1_boards__board_id__columns_reorder_put",
        "parameters": [
          {
            "in": "path",
            "name": "board_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Board Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ColumnReorder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ColumnRead"
                  },
                  "title": "Response Reorder Columns Api V1 Boards  Board Id  Columns Reorder Put",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No eres miembro de este tablero, o la columna no existe."
          },
          "422": {
            "description": "La lista no coincide exactamente con las columnas actuales del tablero."
          }
        },
        "summary": "Reordena todas las columnas de un tablero en una sola llamada",
        "tags": [
          "columns"
        ]
      }
    },
    "/api/v1/boards/{board_id}/columns/{column_id}": {
      "delete": {
        "operationId": "delete_column_api_v1_boards__board_id__columns__column_id__delete",
        "parameters": [
          {
            "in": "path",
