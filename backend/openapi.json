              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Tamaño de página, máximo 100",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Tamaño de página, máximo 100",
              "maximum": 100,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_BoardRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lista los tableros de los que el actor autenticado es miembro",
        "tags": [
          "boards"
        ]
      },
      "post": {
        "operationId": "create_board_api_v1_boards_post",
        "requestBody": {
          "content": {
