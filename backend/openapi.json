{
  "components": {
    "schemas": {
      "ActorRead": {
        "description": "Deliberately without `email`: an actor is identified by type and visible\nname, not by its credential. Keeps this schema agnostic of the actor's kind —\nwhen TASK-09 adds agents, the same schema serves them without changes.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "person",
              "agent"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name",
          "created_at"
        ],
        "title": "ActorRead",
        "type": "object"
      },
      "BoardCreate": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "BoardCreate",
        "type": "object"
      },
      "BoardMemberCreate": {
        "properties": {
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "role": {
            "default": "member",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "actor_id"
        ],
        "title": "BoardMemberCreate",
        "type": "object"
      },
      "BoardMemberRead": {
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/ActorRead"
          },
          "board_id": {
            "format": "uuid",
            "title": "Board Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "board_id",
          "actor",
          "role",
          "created_at"
        ],
        "title": "BoardMemberRead",
        "type": "object"
      },
      "BoardRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "role"
        ],
        "title": "BoardRead",
        "type": "object"
      },
      "BoardUpdate": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "BoardUpdate",
        "type": "object"
      },
      "ColumnCreate": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "wip_limit": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wip Limit"
          }
        },
        "required": [
          "name"
        ],
        "title": "ColumnCreate",
        "type": "object"
      },
      "ColumnRead": {
        "properties": {
          "board_id": {
            "format": "uuid",
            "title": "Board Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "number"
          },
          "wip_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wip Limit"
          }
        },
        "required": [
          "id",
          "board_id",
          "name",
          "wip_limit",
          "position",
          "created_at"
        ],
        "title": "ColumnRead",
        "type": "object"
      },
      "ColumnReorder": {
        "properties": {
          "column_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Column Ids",
            "type": "array"
          }
        },
        "required": [
          "column_ids"
        ],
        "title": "ColumnReorder",
        "type": "object"
      },
      "ColumnUpdate": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "wip_limit": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wip Limit"
          }
        },
        "required": [
          "name"
        ],
        "title": "ColumnUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "description": "Liveness: the process is up. Says nothing about its dependencies.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthRead",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Page_BoardMemberRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BoardMemberRead"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "title": "Page[BoardMemberRead]",
        "type": "object"
      },
      "Page_BoardRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BoardRead"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "title": "Page[BoardRead]",
        "type": "object"
      },
      "Page_ColumnRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ColumnRead"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "size"
        ],
        "title": "Page[ColumnRead]",
        "type": "object"
      },
      "ReadinessRead": {
        "description": "Readiness: the process can actually serve traffic.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessRead",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "API de tableros kanban de kanbai.",
    "title": "kanbai",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Las credenciales no son válidas."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inicia sesión con email y contraseña",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Idempotent: with no cookie, or an already-expired one, this still returns\n204 — closing a session that is not open is not an error.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Cierra la sesión actual",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No hay una sesión activa."
          }
        },
        "summary": "Actor autenticado en la sesión actual",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/boards": {
      "get": {
